# =====================================================================
# SpecTa Education — environment variables
# Copy to ".env" for local dev. On Railway, set in the service Variables tab.
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000
# Public base URL of the app. Local: http://localhost:5173. Prod: your Railway/custom domain.
APP_URL=http://localhost:5173

# ---------- Database (REQUIRED) ----------
# On Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=

# ---------- Auth: Sessions ----------
# Generate: openssl rand -hex 32
JWT_SECRET=

# ---------- Auth: Google OAuth ----------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email of the user automatically granted admin role on first login.
OWNER_EMAIL=

# ---------- LLM: DeepSeek ----------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---------- Speech-to-text: OpenAI Whisper ----------
# https://platform.openai.com
OPENAI_API_KEY=

# ---------- Image generation: DeepInfra FLUX ----------
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-1-schnell

# ---------- File storage ----------
# Pick ONE: Cloudflare R2 (preferred) OR AWS S3. R2 wins if both set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=specta-education
R2_PUBLIC_URL=

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# ---------- Email ----------
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@spectaeducation.com

# ---------- Payments: Xendit ----------
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
